# Copie para .env e preencha. O .env nunca vai para o git.
# Em produção o site não sobe com esta chave de exemplo. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://postgres:senha@localhost:5432/habonim_dror
# Endereço do painel admin (nunca "admin/"). Gere um aleatório, ex.:
#   python -c "import secrets; print('painel-' + secrets.token_hex(6) + '/')"
DJANGO_ADMIN_URL=painel-troque-isto/

# Só em produção:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://exemplo.org.br
# True se o site rodar atrás de um proxy (nginx etc.) que preenche X-Forwarded-For.
# Sem isso, o bloqueio de tentativas de login trataria todo mundo como o mesmo IP.
# DJANGO_ATRAS_DE_PROXY=True
